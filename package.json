{
  "name": "icebergplaybook",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "bootstrap:content": "node scripts/bootstrap_content.mjs",
    "storage:audit-orphans": "node scripts/prune_orphan_media.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:server": "esbuild server/src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=server/dist/index.mjs",
    "start": "node server/dist/index.mjs",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@supabase/supabase-js": "^2.117.2",
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "lucide-react": "^1.34.0",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
