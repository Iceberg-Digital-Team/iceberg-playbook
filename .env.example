# Iceberg Playbook - Client Environment Variables
# Copy this file to .env.local for local development.
#
# IMPORTANT:
# - VITE_SUPABASE_URL is required.
# - One Supabase client/public key is required.
# - VITE_SUPABASE_PUBLISHABLE_KEY and VITE_SUPABASE_ANON_KEY are alternatives (specify at least one).
# - Never place Supabase service_role keys or database passwords in Vite client environment variables.

# Supabase Project URL (e.g. https://your-project-id.supabase.co) - Required
VITE_SUPABASE_URL=

# Supabase Client Public Key - One of the following is required:
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# ==============================================================================
# REFERENCE BACKEND MAINTENANCE & CLI SCRIPTS (SERVER-SIDE ONLY)
# ==============================================================================
# The variables below are used ONLY by administrative CLI maintenance scripts
# (e.g. `npm run bootstrap:content` and `npm run storage:audit-orphans`)
# executing against the Supabase reference backend.
#
# CRITICAL SECURITY RULES:
# - Server / maintenance use ONLY.
# - NEVER expose through VITE_* variables.
# - NEVER bundle or ship to the browser/client.
# - Only relevant when executing the Supabase reference maintenance or
#   bootstrap adapter. When migrating to Iceberg's production backend,
#   replace these with Iceberg's administrative credentials.
# ==============================================================================

# Supabase Service Role Key (Bypasses RLS - Server/CLI maintenance only)
# Used by: scripts/bootstrap_content.mjs, scripts/prune_orphan_media.mjs
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Supabase URL alias for CLI scripts (defaults to VITE_SUPABASE_URL if not set)
SUPABASE_URL=

# ==============================================================================
# API SERVER (server/) - plain PostgreSQL deployment (Railway / Docker)
# ==============================================================================
# These are read by the Node server, never by the browser build.
# The frontend is served by the same server, so no VITE_* variable is needed
# (set VITE_API_URL only when the API lives on a different origin).
#
# DATABASE_URL=postgres://user:password@host:5432/dbname   (Railway: ${{Postgres.DATABASE_URL}})
# JWT_SECRET=<random string, 32+ characters>               (openssl rand -hex 32)
# STORAGE_DIR=/data/storage                                 (mount a persistent volume here)
# PUBLIC_URL=https://your-app.up.railway.app                (optional; Railway's public domain is detected)
# ADMIN_EMAIL= / ADMIN_PASSWORD= (12+ chars) / ADMIN_NAME=  (creates the first Admin when none exists)
# SEED_DEMO_DATA=false                                      (true applies supabase/migrations/05_seed_data.sql)
# DATABASE_SSL=false                                        (true if the database requires TLS)
